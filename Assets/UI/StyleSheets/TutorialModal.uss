.overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.65);
    align-items: center;
    justify-content: center;
}

.modal-container {
    width: 75%;
    height: 80%;
    background-color: #1B3B2B; /* Replace with your menu's exact dark green */
    border-radius: 12px;
    border-width: 3px;
    border-color: #2E5A44;
    padding: 20px;
    flex-direction: column;
    justify-content: space-between;
}

.header {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 50px;
    margin-bottom: 12px;
}

.close-btn {
    position: absolute;
    left: 0;
    top: 0;
    width: 40px;
    height: 40px;
    font-size: 20px;
    -unity-font-style: bold;
    background-color: #8B2626;
    color: white;
    border-radius: 6px;
}

.close-btn:hover {
    background-color: #A83232;
}

.title {
    font-size: 28px;
    -unity-font-style: bold;
    color: #F0F4F1;
    -unity-text-align: middle-center;
}

.image-container {
    flex-grow: 1;
    width: 100%;
    margin-bottom: 16px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.footer {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    height: 48px;
}

.nav-btn, .confirm-btn {
    height: 40px;
    padding-left: 16px;
    padding-right: 16px;
    font-size: 16px;
    -unity-font-style: bold;
    border-radius: 6px;
    margin-left: 8px;
    color: white;
    background-color: #2E5A44;
}

.confirm-btn {
    background-color: #3A7D44;
    margin-left: 16px;
}

.counter-label {
    font-size: 16px;
    color: #D8E2DC;
    margin-left: 12px;
    margin-right: 4px;
    min-width: 50px;
    -unity-text-align: middle-center;
}

/* Blanked-out state when SetEnabled(false) is called */
.nav-btn:disabled, .confirm-btn:disabled {
    opacity: 0.35;
    background-color: #1A2E23;
    color: #7A8F82;
}