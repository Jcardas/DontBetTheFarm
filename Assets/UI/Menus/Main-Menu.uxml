<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="Creature3DRender" src="project://database/Assets/UI/Components/Creature3DRender.uxml?fileID=9197481963319205126&amp;guid=d064ec4722f12974d834e5f8573007a8&amp;type=3#Creature3DRender"/>
    <Style src="project://database/Assets/UI/StyleSheets/InteractionUI.uss?fileID=7433441132597879392&amp;guid=3c26107ceb91787478132dd32f00eb5c&amp;type=3#InteractionUI"/>
    <ui:VisualElement name="UI_PANE" style="flex-grow: 1; width: 1920px; height: 1080px;">
        <ui:VisualElement name="Background" style="flex-grow: 1; position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.549); margin-top: 30px; margin-right: 30px; margin-bottom: 30px; margin-left: 30px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; filter: blur(2);"/>
        <ui:VisualElement name="UIPaneContainer" style="flex-grow: 1; padding-left: 50px; padding-right: 50px; padding-top: 50px; padding-bottom: 50px;">
            <ui:VisualElement name="PanelContainer" style="flex-grow: 1; justify-content: flex-start;">
                <ui:VisualElement name="TitlePane" style="flex-grow: 1; flex-direction: row; max-height: 20%;">
                    <ui:Label text="Dont Bet The Farm!" name="Title" class="title" style="-unity-text-align: middle-center;"/>
                    <ui:VisualElement name="ContentPane" style="flex-grow: 0; max-width: 830px; min-width: 500px; width: 131px; justify-content: space-between;"/>
                </ui:VisualElement>
                <ui:VisualElement name="MainContent" style="flex-grow: 1; flex-direction: row; max-height: 100%;">
                    <ui:VisualElement name="LeftSide" style="flex-grow: 1; width: 30%;">
                        <ui:VisualElement name="Spacer" style="flex-grow: 1; height: 50%;"/>
                        <ui:VisualElement name="ContentPane" style="flex-grow: 1; max-width: none; min-width: auto; width: auto; justify-content: space-between; height: 400px;">
                            <ui:Button text="Load Game" name="LoadGameButton" class="button"/>
                            <ui:Button text="New Game" name="NewGameButton" class="button"/>
                            <ui:Button text="Options" name="OptionsButton" class="button"/>
                            <ui:Button text="Credits" name="CreditsButton" class="button"/>
                            <ui:Button text="Exit" name="ExitButton" class="button"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="AsideSection" style="flex-grow: 1; width: 100%; align-items: stretch; justify-content: center; padding-left: 50px; padding-right: 50px;">
                        <ui:VisualElement name="CreaturePreview" style="flex-direction: row; justify-content: center; align-items: center; align-self: center; align-content: auto; height: 100%; width: 100%; margin-top: 0; margin-bottom: 0;">
                            <ui:Instance template="Creature3DRender" name="Creature3DRender" style="flex-grow: 0; aspect-ratio: 1; max-height: none; max-width: none; align-items: center; justify-content: center; align-self: center; align-content: auto; flex-direction: column; min-width: 52px; min-height: 0; height: 100%;"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
