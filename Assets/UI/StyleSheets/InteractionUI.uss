:root {
}

* {
    cursor: url("project://database/Assets/UI/Cursors/pointer_b_shaded.png?fileID=2800000&guid=5453a4e6fbd0e4b4d92a242ac56e4b44&type=3#pointer_b_shaded");
}

.header {
    font-size: 32px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=cbce476ed8aef1b48a1fd5ca72adeec2&type=3#NotInter-Regular");
}

.button {
    font-size: 32px;
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    background-color: rgb(42, 72, 53);
    cursor: url("project://database/Assets/UI/Cursors/hand_small_point.png?fileID=2800000&guid=fedc076baeb05804cab1ff17dd39e132&type=3#hand_small_point");
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

.TabSelector {
    background-color: rgb(22, 38, 32);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    padding-top: 6px;
    padding-right: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
    max-height: 62px;
    max-width: 100%;
}

.translucentPanel {
    background-color: rgba(22, 38, 32, 0.51);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
}

.mutationContainer {
    background-color: rgba(42, 72, 53, 0.678);
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    margin-left: 4px;
    margin-right: 4px;
}

.cancelButton {
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    background-color: rgb(79, 79, 79);
    cursor: url("project://database/Assets/UI/Cursors/hand_small_point.png?fileID=2800000&guid=fedc076baeb05804cab1ff17dd39e132&type=3#hand_small_point");
}

.description-text {
    color: rgb(255, 255, 255);
    font-size: 16px;
}

.descriptionHeader {
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 18px;
}

.SolidPanel {
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    background-color: rgb(22, 38, 32);
}

.cursor-clickable * {
    cursor: url("project://database/Assets/UI/Cursors/hand_small_point.png?fileID=2800000&guid=fedc076baeb05804cab1ff17dd39e132&type=3#hand_small_point");
}

.button * {
    cursor: url("project://database/Assets/UI/Cursors/hand_small_point.png?fileID=2800000&guid=fedc076baeb05804cab1ff17dd39e132&type=3#hand_small_point");
}

.tabButton {
    cursor: url("project://database/Assets/UI/Cursors/hand_small_point.png?fileID=2800000&guid=fedc076baeb05804cab1ff17dd39e132&type=3#hand_small_point");
    background-color: rgb(22, 38, 32);
}

.tabButton active {
    background-color: rgb(42, 72, 53);
}

#UI_PANE {
    width: 100%;
    height: 100%;
    flex-direction: column;
    flex-grow: 1;
}

#TopBar {
    flex-shrink: 0;
}

#AnimalsView,
#BreedingView {
    flex-grow: 1;
    flex-shrink: 1;
    flex-basis: 0;
    width: 100%;
}

.horizontalScrollbar {
    margin-top: 4px;
    background-color: transparent;
}

.unity-scroller--vertical {
    width: 10px;
    margin-left: 4px;
    background-color: transparent;
}

.unity-scroller--vertical .unity-scroller__low-button,
.unity-scroller--vertical .unity-scroller__high-button {
    display: none;
}

.unity-scroller--vertical .unity-base-slider,
.unity-scroller--vertical .unity-base-slider__tracker {
    background-color: transparent;
    border-width: 0;
    margin: 0;
    padding: 0;
}

.unity-scroller--vertical .unity-base-slider__dragger {
    width: 8px;
    left: 1px;
    background-color: rgb(46, 139, 87);
    border-radius: 4px;
    border-width: 0;
}

.unity-scroller--vertical .unity-base-slider__dragger:hover {
    background-color: rgb(60, 175, 110);
}

.unity-scroller--vertical .unity-base-slider__dragger:active {
    background-color: rgb(76, 205, 130);
}

.horizontalScrollbar .unity-scroller--horizontal .unity-scroller__low-button,
.horizontalScrollbar .unity-scroller--horizontal .unity-scroller__high-button {
    display: none;
}

.horizontalScrollbar .unity-scroller--horizontal .unity-base-slider,
.horizontalScrollbar .unity-scroller--horizontal .unity-base-slider__tracker {
    background-color: transparent;
    border-width: 0;
    margin: 0;
    padding: 0;
}

.horizontalScrollbar .unity-scroller--horizontal .unity-base-slider__dragger {
    height: 8px;
    top: 1px;
    background-color: rgb(46, 139, 87);
    border-radius: 4px;
    border-width: 0;
}

.horizontalScrollbar .unity-scroller--horizontal .unity-base-slider__dragger:hover {
    background-color: rgb(60, 175, 110);
}

.horizontalScrollbar .unity-scroller--horizontal .unity-base-slider__dragger:active {
    background-color: rgb(76, 205, 130);
}

.breeding-parent-slot {
    width: 320px;
    height: 320px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-color: rgba(255, 255, 255, 0.5);
    border-bottom-color: rgba(255, 255, 255, 0.5);
    border-left-color: rgba(255, 255, 255, 0.5);
    border-right-color: rgba(255, 255, 255, 0.5);
    border-radius: 12px;
    background-color: rgba(22, 38, 32, 0.35);
    align-items: center;
    justify-content: center;
    overflow: hidden;
}

.slot-drop-valid,
.breeding-parent-slot.slot-drop-valid {
    border-top-color: rgb(110, 220, 130);
    border-bottom-color: rgb(110, 220, 130);
    border-left-color: rgb(110, 220, 130);
    border-right-color: rgb(110, 220, 130);
    border-top-width: 3px;
    border-bottom-width: 3px;
    border-left-width: 3px;
    border-right-width: 3px;
}

.slot-drop-invalid,
.breeding-parent-slot.slot-drop-invalid {
    border-top-color: rgb(210, 80, 80);
    border-bottom-color: rgb(210, 80, 80);
    border-left-color: rgb(210, 80, 80);
    border-right-color: rgb(210, 80, 80);
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-right-width: 2px;
    opacity: 0.5;
}

.slot-drop-hover,
.breeding-parent-slot.slot-drop-hover {
    scale: 1.05 1.05;
    background-color: rgba(110, 220, 130, 0.25);
}

.title {
    font-size: 72px;
    -unity-font-definition: url("project://database/Assets/UI%20Toolkit/UnityThemes/UnityDefaultRuntimeTheme.tss?fileID=2230732570650464555&guid=cbce476ed8aef1b48a1fd5ca72adeec2&type=3#NotInter-Regular");
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
}
