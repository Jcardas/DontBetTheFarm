.overlay {
    position: absolute;
    width: 100%;
    height: 100%;
    background-color: rgba(0, 0, 0, 0.65);
    align-items: center;
    justify-content: center;
}

.modal-container {
    width: 75%;
    height: 80%;
    background-color: rgb(27, 59, 43);
    border-radius: 12px;
    border-width: 3px;
    border-color: rgb(46, 90, 68);
    padding: 20px;
    flex-direction: column;
    justify-content: space-between;
}

.header {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 50px;
    margin-bottom: 12px;
}

.close-btn {
    position: absolute;
    left: 0;
    top: 0;
    width: 40px;
    height: 40px;
    font-size: 20px;
    -unity-font-style: bold;
    background-color: rgb(168, 50, 50);
    color: white;
    border-radius: 6px;
}

.close-btn:hover {
    background-color: rgb(139, 38, 38);
    cursor: url("project://database/Assets/UI/Cursors/hand_small_point.png?fileID=2800000&guid=fedc076baeb05804cab1ff17dd39e132&type=3#hand_small_point");
}

.title {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(240, 244, 241);
    -unity-text-align: middle-center;
}

.image-container {
    flex-grow: 1;
    width: 100%;
    margin-bottom: 16px;
    background-color: rgba(0, 0, 0, 0.25);
    border-radius: 8px;
    -unity-background-scale-mode: scale-to-fit;
}

.footer {
    flex-direction: row;
    justify-content: flex-end;
    align-items: center;
    height: 48px;
}

.nav-btn:hover {
    border-radius: 6px;
    cursor: url("project://database/Assets/UI/Cursors/hand_small_point.png?fileID=2800000&guid=fedc076baeb05804cab1ff17dd39e132&type=3#hand_small_point");
    background-color: rgb(32, 55, 40);
}

.confirm-btn,
.confirm-btn {
    height: 40px;
    padding-left: 16px;
    padding-right: 16px;
    font-size: 16px;
    -unity-font-style: bold;
    border-radius: 6px;
    margin-left: 8px;
    color: white;
    background-color: rgb(58, 125, 68);
}

.confirm-btn:hover {
    height: 40px;
    padding-left: 16px;
    padding-right: 16px;
    font-size: 16px;
    -unity-font-style: bold;
    border-radius: 6px;
    margin-left: 8px;
    color: white;
    background-color: rgb(50, 99, 57);
}

.counter-label {
    font-size: 16px;
    color: rgb(216, 226, 220);
    margin-left: 12px;
    margin-right: 4px;
    min-width: 50px;
    -unity-text-align: middle-center;
}

.nav-btn:disabled {
    opacity: 0.35;
    background-color: rgb(26, 46, 35);
    color: rgb(122, 143, 130);
}

.confirm-btn:disabled,
.confirm-btn:disabled {
    opacity: 0.35;
    background-color: rgb(26, 46, 35);
    color: rgb(122, 143, 130);
}
