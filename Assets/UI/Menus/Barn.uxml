<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:Template name="MutationIcon" src="project://database/Assets/UI/Components/MutationIcon.uxml?fileID=9197481963319205126&amp;guid=fb4438fa962014e43be13f25767f04a4&amp;type=3#MutationIcon"/>
    <ui:Template name="SelectedMutationContainer" src="project://database/Assets/UI/Components/SelectedMutationContainer.uxml?fileID=9197481963319205126&amp;guid=92365090be28b5641a121009c7cf89c4&amp;type=3#SelectedMutationContainer"/>
    <Style src="project://database/Assets/UI/StyleSheets/InteractionUI.uss?fileID=7433441132597879392&amp;guid=3c26107ceb91787478132dd32f00eb5c&amp;type=3#InteractionUI"/>
    <ui:VisualElement name="UI_PANE" style="flex-grow: 1; width: 1920px; height: 1080px;">
        <ui:VisualElement name="Background" style="flex-grow: 1; position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.549); margin-top: 30px; margin-right: 30px; margin-bottom: 30px; margin-left: 30px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; filter: blur(2);"/>
        <ui:VisualElement name="UIPaneContainer" style="flex-grow: 1; padding-left: 50px; padding-right: 50px; padding-top: 50px; padding-bottom: 50px;">
            <ui:VisualElement name="PanelContainer" style="flex-grow: 1; justify-content: flex-start;">
                <ui:VisualElement name="NavHeader" style="flex-grow: 1; height: auto; justify-content: center; align-items: flex-start; max-height: 75px; margin-bottom: 20px;">
                    <ui:VisualElement name="NavigationContainer" style="flex-grow: 1; flex-direction: row; height: auto; max-height: none; max-width: none; align-items: center; justify-content: flex-start; background-color: rgb(22, 38, 32); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; padding-top: 6px; padding-right: 6px; padding-bottom: 6px; padding-left: 6px;">
                        <ui:Button text="" name="BackButton" icon-image="project://database/Assets/UI/Cursors/Unused/arrow_w.png?fileID=2800000&amp;guid=3e30aa2d7d8b8a84c8f4b674ed72eacb&amp;type=3#arrow_w" class="button" style="background-color: rgba(0, 0, 0, 0); border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); aspect-ratio: 1; align-self: center;"/>
                        <ui:VisualElement name="Tabs" style="flex-grow: 1; flex-direction: row; align-content: auto; align-self: auto; justify-content: flex-start; align-items: auto; max-width: 100%;">
                            <ui:Button text="Research" name="ResearchButton" icon-image="project://database/Assets/UI/MutationMenuAssets/ResearchHouseIcon.png?fileID=2800000&amp;guid=31e42f9b218a37f4d8178d15f86c83a7&amp;type=3#ResearchHouseIcon" class="button" style="align-items: stretch; align-content: flex-start; font-size: 24px; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;"/>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement name="LowerContent" style="flex-grow: 1; flex-direction: row; max-height: 100%;">
                    <ui:VisualElement name="PreviewPane" class="translucentPanel" style="flex-grow: 1; justify-content: flex-start; align-items: center; align-self: auto; padding-top: 16px; padding-right: 16px; padding-bottom: 16px; padding-left: 16px; max-width: 960px; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; margin-right: 24px;">
                        <ui:VisualElement name="AlienSelectionHeader" style="flex-grow: 1; flex-direction: row; justify-content: space-between; align-items: auto; max-width: 960%; width: 100%; max-height: 75px;">
                            <ui:Label text="Alien Name" name="AlienHeader" class="header" style="align-self: center;"/>
                            <ui:Label text="1/10" name="AliensInBarnCount" class="header" style="align-self: center;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="CreaturePreview" style="flex-direction: row; justify-content: center; align-items: auto; align-self: center; align-content: auto; height: 50%; width: 100%; margin-top: 20px; margin-bottom: 20px;">
                            <ui:Button text="" name="Back" icon-image="project://database/Assets/UI/Cursors/Unused/arrow_w.png?fileID=2800000&amp;guid=3e30aa2d7d8b8a84c8f4b674ed72eacb&amp;type=3#arrow_w" class="button cursor-clickable" style="aspect-ratio: 1; height: 60px; align-self: center; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; margin-left: 0; margin-right: 0; margin-top: 0; margin-bottom: 0; padding-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0;"/>
                            <ui:VisualElement name="Creature3DRender" style="aspect-ratio: 1; width: auto; align-items: stretch; margin-left: 0; margin-right: 0; background-image: url(&quot;project://database/Assets/Creature%20Render%20Textures/RT_CreaturePreview.renderTexture?fileID=8400000&amp;guid=1c90ca7d13c1e2041bf3d745c995b0a1&amp;type=2#RT_CreaturePreview&quot;); align-self: stretch; height: auto; cursor: url(&quot;project://database/Assets/UI/Cursors/Unused/resize_a_horizontal.png?fileID=2800000&amp;guid=9708865f34255ee46a704be3cdda2e80&amp;type=3#resize_a_horizontal&quot;);"/>
                            <ui:Button text="" name="Forward" icon-image="project://database/Assets/UI/Cursors/Unused/arrow_e.png?fileID=2800000&amp;guid=4b94d942001957c4d963232d656f2aa7&amp;type=3#arrow_e" class="button cursor-clickable" style="aspect-ratio: 1; height: 60px; align-self: center; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); margin-top: 0; margin-left: 0; margin-bottom: 0; margin-right: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;"/>
                        </ui:VisualElement>
                        <ui:VisualElement name="MutationsSection" style="flex-grow: 1;">
                            <ui:Label text="Select Mutations to Unlock" name="MutationSelectionHeader" class="header" style="align-self: center;"/>
                            <ui:VisualElement name="MutationsList" style="flex-grow: 1; flex-direction: row; align-self: auto; justify-content: center; align-items: center; align-content: auto; width: 100%; max-height: 200px; padding-top: 10px;">
                                <ui:Instance template="MutationIcon"/>
                                <ui:Instance template="MutationIcon"/>
                                <ui:Instance template="MutationIcon"/>
                                <ui:Instance template="MutationIcon"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="ContentPane" style="flex-grow: 1;">
                        <ui:ScrollView name="CheckoutScrollView" vertical-scroller-visibility="Hidden" focusable="false" class="translucentPanel" style="visibility: visible; display: flex; overflow: visible; flex-grow: 1; margin-bottom: 20px; -unity-text-align: upper-left; justify-content: flex-start; align-items: flex-start; flex-direction: column; align-self: auto; padding-bottom: 10px; flex-wrap: nowrap; opacity: 1;">
                            <ui:Instance template="SelectedMutationContainer" class="cursor-clickable"/>
                            <ui:Instance template="SelectedMutationContainer" class="cursor-clickable"/>
                            <ui:Instance template="SelectedMutationContainer" class="cursor-clickable"/>
                            <ui:Instance template="SelectedMutationContainer" class="cursor-clickable"/>
                        </ui:ScrollView>
                        <ui:VisualElement name="MutationCheckoutContainer" class="TabSelector" style="flex-grow: 1; max-height: 120px; flex-direction: row; justify-content: space-between;">
                            <ui:Button text="Cancel" name="CancelButton" class="button cancelButton" style="align-items: stretch; align-content: flex-start; font-size: 24px; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; align-self: auto; justify-content: flex-start; width: 100%; max-width: 300px;"/>
                            <ui:Button text="Unlock" name="UnlockButton" icon-image="project://database/Assets/UI/Cursors/Unused/lock_unlocked.png?fileID=2800000&amp;guid=c72fbccd26495554e8f1314f8eeefd57&amp;type=3#lock_unlocked" class="button" style="align-items: stretch; align-content: flex-start; font-size: 24px; border-left-color: rgba(149, 149, 149, 0); border-right-color: rgba(149, 149, 149, 0); border-top-color: rgba(149, 149, 149, 0); border-bottom-color: rgba(149, 149, 149, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; width: 75%; max-width: 100%; flex-grow: 1; flex-shrink: 1; align-self: auto; justify-content: center;"/>
                            <ui:VisualElement name="TotalCostLabel" style="flex-grow: 1; aspect-ratio: 1; justify-content: center; align-self: center; max-width: 10%; width: 100%; -unity-text-align: upper-center; align-items: center; flex-direction: row;">
                                <ui:Label text="200" name="Cost" class="header descriptionHeader" style="font-size: 24px;"/>
                                <ui:Image name="CostIcon" source="project://database/Assets/UI/Icons/PROTOTYPE_MISSING_ICON.png?fileID=8520217413990361559&amp;guid=b91736b96387c4d4ab44ad2fd62ca7a8&amp;type=3#PROTOTYPE_MISSING_ICON_0" style="aspect-ratio: 1;"/>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
