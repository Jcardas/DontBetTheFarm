<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/StyleSheets/TutorialModal.uss?fileID=7433441132597879392&amp;guid=c9a1abd27e748cd4abaf63ed8015ff06&amp;type=3#TutorialModal"/>
    <Style src="project://database/Assets/UI/StyleSheets/InteractionUI.uss?fileID=7433441132597879392&amp;guid=3c26107ceb91787478132dd32f00eb5c&amp;type=3#InteractionUI"/>
    <ui:VisualElement name="tutorial-overlay" class="overlay">
        <ui:VisualElement name="tutorial-modal" class="modal-container">
            <ui:VisualElement name="header" class="header">
                <ui:Button name="btn-close-x" text="X" class="close-btn" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; align-items: center; justify-content: center; align-self: center; width: 50px; height: 50px;"/>
                <ui:Label name="title-label" text="How to play!" class="title" style="font-size: 48px;"/>
            </ui:VisualElement>
            <ui:VisualElement name="image-container" class="image-container" style="aspect-ratio: 1.777778; align-items: center; justify-content: center; align-self: center; margin-bottom: 0;">
                <ui:Image source="project://database/Assets/UI/TutorialSlides/Tutorial2.png?fileID=2800000&amp;guid=4ff018bcf0215594193bcd6ef44664d5&amp;type=3#Tutorial2" scale-mode="StretchToFill" name="tutorial-slide-image" style="flex-grow: 1; max-width: 100%; aspect-ratio: 1.777778; max-height: 100%;"/>
            </ui:VisualElement>
            <ui:VisualElement name="footer" class="footer" style="margin-top: 10px;">
                <ui:Button name="btn-back" text="Back" class="nav-btn button" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 26px;"/>
                <ui:Label name="page-counter" text="1 / 1" class="counter-label description-text"/>
                <ui:Button name="btn-next" text="Next" class="nav-btn button" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 26px;"/>
                <ui:Button name="btn-confirm" text="Confirm &amp; Close" class="confirm-btn" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; font-size: 26px; cursor: url(&quot;project://database/Assets/UI/Cursors/hand_small_point.png?fileID=2800000&amp;guid=fedc076baeb05804cab1ff17dd39e132&amp;type=3#hand_small_point&quot;);"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
